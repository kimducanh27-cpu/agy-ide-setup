{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apes.local/schemas/task-graph.schema.json",
  "title": "APES Canonical Task Graph",
  "description": "Canonical task and dependency graph. FlowPlan is a visual projection of this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "source", "planState", "milestones", "tasks", "criticalPath", "openQuestions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "workflowId"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "workflowId": { "enum": ["quick-fix", "standard-feature", "full-project", "deep-research", "hard-review"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefPath", "masterPlanPath", "revision", "createdAt"],
      "properties": {
        "briefPath": { "type": "string", "minLength": 1 },
        "masterPlanPath": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "planState": { "enum": ["DRAFT", "READY_FOR_REVIEW", "APPROVED", "BLOCKED", "SUPERSEDED"] },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "outcome", "taskIds", "exitCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]{1,3}$" },
          "title": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "taskIds": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{3,4}$" }, "uniqueItems": true },
          "entryCriteria": { "type": "array", "items": { "type": "string" } },
          "exitCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "cardType", "milestoneId", "objective", "deliverable", "owner", "dependencies", "acceptanceCriteria", "verification", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{3,4}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "cardType": { "enum": ["research", "planning", "create", "edit", "test"] },
          "milestoneId": { "type": "string", "pattern": "^M[0-9]{1,3}$" },
          "objective": { "type": "string", "minLength": 1 },
          "why": { "type": "string" },
          "deliverable": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "included": { "type": "array", "items": { "type": "string" } },
              "excluded": { "type": "array", "items": { "type": "string" } }
            }
          },
          "files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agentId", "responsibility"],
            "properties": {
              "agentId": {
                "enum": [
                  "user",
                  "apes-orchestrator",
                  "apes-project-analyst",
                  "apes-github-researcher",
                  "apes-solution-architect",
                  "apes-implementation-engineer",
                  "apes-qa-engineer",
                  "apes-ui-ux-reviewer",
                  "apes-security-reviewer",
                  "apes-harness-evaluator"
                ]
              },
              "responsibility": { "type": "string", "minLength": 1 }
            }
          },
          "reviewerIds": {
            "type": "array",
            "items": {
              "enum": [
                "apes-project-analyst",
                "apes-github-researcher",
                "apes-solution-architect",
                "apes-implementation-engineer",
                "apes-qa-engineer",
                "apes-ui-ux-reviewer",
                "apes-security-reviewer",
                "apes-harness-evaluator"
              ]
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["taskId", "reason"],
              "properties": {
                "taskId": { "type": "string", "pattern": "^T[0-9]{3,4}$" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "verification"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "verification": { "type": "string", "minLength": 1 }
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["methods"],
            "properties": {
              "methods": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "commands": { "type": "array", "items": { "type": "string" } },
              "manualChecks": { "type": "array", "items": { "type": "string" } }
            }
          },
          "risks": { "type": "array", "items": { "type": "string" } },
          "userApprovalRequired": { "type": "boolean", "default": false },
          "status": { "enum": ["NOT_STARTED", "RUNNING", "VERIFIED", "BLOCKED", "NEEDS_REVIEW"] },
          "flowplan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cardId": { "type": ["string", "null"] },
              "published": { "type": "boolean", "default": false },
              "lastSyncedAt": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        }
      }
    },
    "criticalPath": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{3,4}$" }, "uniqueItems": true },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "impact"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "blocksApproval": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
